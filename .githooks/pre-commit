#!/usr/bin/env bash
# ==============================================================================
# Pre-Commit Security & Secret Scanner
# ==============================================================================
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}🔒 Running pre-commit security scan...${NC}"

# 1. Block accidental .env commits (permit .env.example)
STAGED_ENV_FILES=$(git diff --cached --name-only | grep -E '^\.env(\..+)?$' | grep -v '^\.env\.example$' || true)
if [ -n "$STAGED_ENV_FILES" ]; then
    echo -e "${RED}❌ ERROR: Attempting to commit environment files:${NC}"
    echo "$STAGED_ENV_FILES"
    echo -e "${RED}Please unstage these files before committing.${NC}"
    exit 1
fi

# 2. Check with Gitleaks if installed
if command -v gitleaks &> /dev/null; then
    echo "Running Gitleaks scanner..."
    if ! gitleaks protect --staged --verbose --redact; then
        echo -e "${RED}❌ Gitleaks detected secrets in staged files! Commit rejected.${NC}"
        exit 1
    fi
else
    # 3. Built-in fallback: regex pattern check on staged diffs
    DIFF=$(git diff --cached -U0)

    PATTERNS=(
        '-----BEGIN[ A-Z0-9_-]*PRIVATE KEY-----'
        'AKIA[0-9A-Z]{16}'
        'ghp_[0-9a-zA-Z]{36}'
        'github_pat_[0-9a-zA-Z_]{82}'
        'xox[baprs]-[0-9a-zA-Z]{10,48}'
        'sk_live_[0-9a-zA-Z]{24}'
        'AIza[0-9A-Za-z\-_]{35}'
    )

    for PATTERN in "${PATTERNS[@]}"; do
        if echo "$DIFF" | grep -E -q "^\+.*$PATTERN"; then
            echo -e "${RED}❌ Potential secret detected matching pattern: $PATTERN${NC}"
            echo -e "${RED}Commit rejected to prevent leaking credentials.${NC}"
            exit 1
        fi
    done
fi

# 4. Block unresolved merge conflict markers
if git diff --cached --check 2>/dev/null | grep -E "conflict marker" &> /dev/null; then
    echo -e "${RED}❌ ERROR: Unresolved merge conflict markers detected in staged files.${NC}"
    exit 1
fi

# 5. Block accidental oversized files (> 5MB)
MAX_BYTES=5242880 # 5 MB
for file in $(git diff --cached --name-only); do
    if [ -f "$file" ]; then
        FILE_SIZE=$(wc -c < "$file" | tr -d ' ')
        if [ "$FILE_SIZE" -gt "$MAX_BYTES" ]; then
            echo -e "${RED}❌ ERROR: Staged file '$file' is larger than 5MB ($((FILE_SIZE / 1048576))MB).${NC}"
            echo -e "${RED}Large files should not be tracked directly in Git (use Git LFS or object storage).${NC}"
            exit 1
        fi
    fi
done

echo -e "${GREEN}✅ Pre-commit checks passed. Proceeding with commit.${NC}"
exit 0
