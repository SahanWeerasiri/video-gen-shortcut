#!/usr/bin/env bash
# ==============================================================================
# Commit-Msg Hook: Enforce Conventional Commits
# ==============================================================================
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

COMMIT_MSG_FILE="$1"
FIRST_LINE=$(head -n 1 "$COMMIT_MSG_FILE")

# Allow merge commits, revert, fixup/squash commits
if [[ "$FIRST_LINE" =~ ^(Merge|Revert|fixup!|squash!) ]]; then
    exit 0
fi

# Conventional Commit pattern:
# <type>(<optional scope>): <description>
# Allowed types: feat, fix, refactor, docs, test, chore, perf, ci, build, style
CONVENTIONAL_REGEX="^(feat|fix|refactor|docs|test|chore|perf|ci|build|style)(\([a-zA-Z0-9_.-]+\))?!?: .+$"

if ! [[ "$FIRST_LINE" =~ $CONVENTIONAL_REGEX ]]; then
    echo ""
    echo -e "${RED}❌ Invalid commit message format!${NC}"
    echo -e "Your message: \"${YELLOW}$FIRST_LINE${NC}\""
    echo ""
    echo -e "${GREEN}Required format:${NC} <type>(<optional scope>): <description>"
    echo -e "Allowed types:   ${YELLOW}feat, fix, refactor, docs, test, chore, perf, ci, build, style${NC}"
    echo ""
    echo -e "Examples:"
    echo -e "  feat(auth): add jwt authentication"
    echo -e "  fix: handle null pointer on disconnect"
    echo -e "  docs: update environment setup in README"
    echo -e "  chore: update dependencies"
    echo ""
    exit 1
fi

# Keep subject line concise (under 100 characters)
if [ ${#FIRST_LINE} -gt 100 ]; then
    echo ""
    echo -e "${RED}❌ Commit subject is too long (${#FIRST_LINE} characters). Keep under 100 characters.${NC}"
    echo ""
    exit 1
fi

exit 0
