# EditorConfig helps maintain consistent coding styles across different IDEs
# See: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python indentation standard (PEP 8)
[*.{py,pyw}]
indent_size = 4

# Go & Rust standards
[*.go]
indent_style = tab
indent_size = 4

[*.rs]
indent_style = space
indent_size = 4

# Makefiles require hard tabs
[Makefile]
indent_style = tab

# Markdown lines may use intentional trailing whitespace for line breaks
[*.md]
trim_trailing_whitespace = false
