# ==============================================================================
# LTX-Video Generation Shortcut & GUI - Environment Configuration
# ==============================================================================
# Copy this file to .env and customize values for your deployment.
# Usage:
#   cp .env.example .env
#
# NOTE: Never commit your actual .env file to version control.
# ==============================================================================

# ─── GUI & Web Server Settings ────────────────────────────────────────────────
# Network address to bind the GUI server (0.0.0.0 allows LAN/Docker access)
GUI_HOST=0.0.0.0

# Port for the web interface (7860 is standard for Gradio/AI web apps, or 8080)
GUI_PORT=7860

# Application environment: development | production | test
APP_ENV=development

# Enable debug mode and verbose log output (true | false)
DEBUG=true

# Secret key for web sessions (generate with: openssl rand -hex 32)
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string

# ─── LTX-Video Backend Engine ─────────────────────────────────────────────────
# Direct Gradio Space API endpoint for Lightricks LTX-Video Distilled
LTX_BACKEND_URL=https://lightricks-ltx-video-distilled.hf.space

# Optional Hugging Face User Access Token (read token from huggingface.co/settings/tokens)
# Increases rate limits and avoids anonymous queue throttling on Hugging Face Spaces
HF_TOKEN=

# Request timeout in seconds for queue joining and SSE event streaming
REQUEST_TIMEOUT=180

# ─── Default Generation Parameters ────────────────────────────────────────────
# Default target video duration in seconds (allowed range: 0.3s to 8.5s)
DEFAULT_DURATION=2.0

# Default video resolution (must be divisible by 32)
DEFAULT_WIDTH=704
DEFAULT_HEIGHT=512

# Guidance Scale / CFG (higher values increase prompt influence, default 1.0)
DEFAULT_GUIDANCE_SCALE=1.0

# Enable multi-scale texture enhancement pass (true = better quality, false = faster)
DEFAULT_IMPROVE_TEXTURE=true

# Negative prompt used to eliminate motion artifacts and distortion
DEFAULT_NEGATIVE_PROMPT="worst quality, inconsistent motion, blurry, jittery, distorted"

# ─── Storage & File Paths ─────────────────────────────────────────────────────
# Destination directory where generated MP4 videos are saved
OUTPUT_DIR=./downloaded_files

# Maximum allowed upload image size in megabytes (MB)
MAX_UPLOAD_SIZE_MB=50

# ─── SeleniumBase Browser Fallback (Optional) ─────────────────────────────────
# Controls whether the SeleniumBase fallback runs headless or opens a visible browser
SELENIUM_HEADLESS=true

# Path to the Chrome/Chromium/Brave executable for SeleniumBase UC mode
BROWSER_BINARY_PATH=/usr/bin/brave-browser
